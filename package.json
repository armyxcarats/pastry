{
  "scripts": {
    "start": "npm run dev",
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend start",
    "dev:frontend": "npm --prefix frontend run dev"
  },
  "dependencies": {
    "redux": "^5.0.1"
  },
  "devDependencies": {
    "concurrently": "9.2.4"
  },
  "overrides": {
    "shell-quote": "1.12.0"
  }
}
